{% extends 'base.html.twig' %}

{% block title %}Explorer · Ranko{% endblock %}

{% block body %}
    <div class="flex flex-col gap-5">
        <h1 class="text-[30px] leading-tight font-bold tracking-[-0.6px]">Classements de la communauté</h1>

        <nav class="flex flex-wrap gap-2" aria-label="Filtrer par type">
            {% set filters = [{label: 'Tout', href: path('app_explore'), current: kind is null}] %}
            {% for k in kinds %}
                {% set filters = filters|merge([{label: k.label, href: path('app_explore', {kind: k.value}), current: kind == k}]) %}
            {% endfor %}
            {% for filter in filters %}
                <a href="{{ filter.href }}" class="btn {{ filter.current ? 'btn-primary' }}" {% if filter.current %}aria-current="page"{% endif %}>{{ filter.label }}</a>
            {% endfor %}
        </nav>

        {% if rankings is empty %}
            <p>Aucun classement public pour l'instant.</p>
        {% else %}
            {{ include('ranking/_list.html.twig') }}
        {% endif %}
    </div>
{% endblock %}
