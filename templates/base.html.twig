<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Ranko{% endblock %}</title>
        {% block meta %}{% endblock %}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏆</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen flex flex-col">
        <header class="border-b">
            <nav class="mx-auto max-w-5xl px-4 py-3 flex flex-wrap items-center gap-x-6 gap-y-2">
                <a href="{{ path('app_home') }}" class="font-bold">Ranko</a>
                <a href="{{ path('app_artist_index') }}">Artistes</a>
                <a href="{{ path('app_explore') }}">Explorer</a>
                {% if app.user %}
                    <a href="{{ path('app_ranking_index') }}">Mes classements</a>
                {% endif %}
                <div class="ml-auto flex items-center gap-4">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin') }}">Back-office</a>
                    {% endif %}
                    {% if app.user %}
                        <a href="{{ path('app_profile', {username: app.user.username}) }}">{{ app.user.username }}</a>
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">Connexion</a>
                        <a href="{{ path('app_register') }}">Inscription</a>
                    {% endif %}
                </div>
            </nav>
        </header>

        <main class="mx-auto w-full max-w-5xl px-4 py-8 flex-1">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <p class="mb-4 border px-4 py-2" role="status" data-flash="{{ type }}">{{ message }}</p>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
