{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex flex-col gap-6">
        <h1 class="max-w-xl text-[30px] leading-[1.12] font-semibold tracking-[-0.6px] text-pretty md:text-5xl">Classe tes artistes, albums et titres préférés.</h1>

        <div class="flex flex-wrap gap-2">
            <a href="{{ path('app_artist_index') }}" class="btn btn-lg btn-primary">Parcourir les artistes</a>
            {% if app.user %}
                <a href="{{ path('app_ranking_index') }}" class="btn btn-lg">Mes classements</a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn btn-lg">Créer un compte</a>
            {% endif %}
        </div>

        {% if rankings is not empty %}
            <section class="flex flex-col gap-3.5" aria-labelledby="latest-title">
                <div class="flex items-baseline justify-between gap-4">
                    <h2 id="latest-title" class="text-lg font-bold">Derniers classements publics</h2>
                    <a href="{{ path('app_explore') }}" class="text-sm font-semibold underline">Tout voir</a>
                </div>
                {{ include('ranking/_list.html.twig') }}
            </section>
        {% endif %}
    </div>
{% endblock %}
