{% extends 'base.html.twig' %}

{% block title %}{{ profile.username }} · Ranko{% endblock %}

{% block body %}
    {% set is_me = app.user and app.user.id == profile.id %}
    <div class="flex flex-col gap-6">
        <header class="flex flex-col gap-3">
            <h1 class="font-mono text-3xl font-medium">{{ profile.username }}</h1>
            <p class="text-sm text-ink-muted">Membre depuis {{ profile.createdAt|date('m/Y') }}</p>
            <div data-controller="clipboard" data-clipboard-text-value="{{ url('app_profile', {username: profile.username}) }}" class="flex flex-wrap items-center gap-2">
                <button type="button" class="btn" data-action="clipboard#copy" data-clipboard-target="button">Copier le lien du profil</button>
                {% if is_me %}
                    <a href="{{ path('app_logout') }}" class="btn">Déconnexion</a>
                {% endif %}
            </div>
        </header>

        <section class="flex flex-col gap-3.5" aria-labelledby="public-title">
            <h2 id="public-title" class="text-lg font-bold">Classements publics</h2>
            {% if rankings is empty %}
                <p>Aucun classement public{% if is_me %}. Tes classements privés n'apparaissent pas ici{% endif %}.</p>
            {% else %}
                {{ include('ranking/_list.html.twig') }}
            {% endif %}
        </section>
    </div>
{% endblock %}
