{# Variables : ranking_count, item_count, last_activity #}
<section aria-labelledby="stats-title">
    <h2 id="stats-title" class="sr-only">Statistiques</h2>
    <dl class="grid grid-cols-2 gap-3.5 sm:grid-cols-3">
        {% for stat in [
            {label: 'Classements publics', value: ranking_count},
            {label: 'Éléments classés', value: item_count},
        ] %}
            <div class="card flex flex-col gap-2.5 p-3.5">
                <dt class="text-xs font-semibold text-ink-muted">{{ stat.label }}</dt>
                <dd class="flex gap-1">
                    <span class="sr-only">{{ stat.value }}</span>
                    {% for digit in stat.value|split('') %}
                        <span class="counter-digit h-9 w-7 text-xl" aria-hidden="true">{{ digit }}</span>
                    {% endfor %}
                </dd>
            </div>
        {% endfor %}
        <div class="card col-span-2 flex flex-col gap-2.5 p-3.5 sm:col-span-1">
            <dt class="text-xs font-semibold text-ink-muted">Dernière activité</dt>
            <dd class="flex h-9 items-center font-mono text-xl font-medium">{{ last_activity|date('d/m/Y') }}</dd>
        </div>
    </dl>
</section>
