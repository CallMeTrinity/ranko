{# Ouvre (ou crée) le classement de l'utilisateur pour ce type et ce périmètre. Variables : kind, scope (nullable), label #}
{% if app.user %}
    <form method="post" action="{{ path('app_ranking_create') }}">
        <input type="hidden" name="kind" value="{{ kind }}">
        <input type="hidden" name="scopeId" value="{{ scope ? scope.id : '' }}">
        <input type="hidden" name="_token" value="{{ csrf_token('ranking-create') }}">
        <button type="submit" class="btn btn-primary">{{ label }}</button>
    </form>
{% else %}
    <a href="{{ path('app_login') }}" class="btn btn-primary">{{ label }}</a>
{% endif %}
