{% extends 'base.html.twig' %}

{% set can_edit = is_granted('RANKING_EDIT', ranking) %}
{% set token = csrf_token('ranking' ~ ranking.id) %}

{% block title %}{{ ranking.title }} · Ranko{% endblock %}

{% block meta %}
    {% if pool %}
        {# Ajouter ou retirer un élément redirige ici : on rafraîchit sans perdre le défilement. #}
        <meta name="turbo-refresh-method" content="morph">
        <meta name="turbo-refresh-scroll" content="preserve">
    {% endif %}
    {% if ranking.public %}
        {# Aperçu du lien de partage dans les messageries et réseaux sociaux. #}
        {% set top = ranking.items|slice(0, 3) %}
        {% set first = top|first %}
        <meta property="og:type" content="website">
        <meta property="og:title" content="{{ ranking.title }} · par {{ ranking.owner.username }}">
        <meta property="og:description" content="{% for item in top %}{{ loop.index }}. {{ item.name }}{{ not loop.last ? ' · ' }}{% endfor %}">
        <meta property="og:url" content="{{ url('app_ranking_show', {id: ranking.id}) }}">
        {% if first and first.kind.value != 'artist' %}
            {% set album = first.kind.value == 'album' ? first : first.album %}
            {% if album.coverPath %}
                <meta property="og:image" content="{{ album.coverPath|imagine_filter('square_1024') }}">
            {% elseif album.coverUrl %}
                <meta property="og:image" content="{{ album.coverUrl }}">
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}

{% block body %}
    {% set items = ranking.items %}
    {% set share_url = url('app_ranking_show', {id: ranking.id}) %}

    <div class="flex flex-col gap-[18px]">
        <nav class="text-sm text-ink-muted">
            {% if can_edit %}
                <a href="{{ path('app_ranking_index') }}">‹ Mes classements</a>
            {% else %}
                <a href="{{ path('app_profile', {username: ranking.owner.username}) }}">‹ {{ ranking.owner.username }}</a>
            {% endif %}
        </nav>

        <header class="card overflow-hidden">
            <div class="stripes-stack h-[30px]" aria-hidden="true"></div>
            <div class="flex items-center gap-3.5 p-4">
                {{ include('catalog/_cover.html.twig', {item: items|first ?: null, seed: ranking.id, class: 'size-24 rounded-cover', sizes: '96px'}) }}
                <div class="flex min-w-0 flex-col gap-1.5">
                    <h1 class="font-mono text-[19px] leading-tight font-medium uppercase md:text-2xl">{{ ranking.title }}</h1>
                    <p class="text-[13px] leading-snug text-ink-muted">
                        {% if ranking.custom %}{{ ranking.itemKind.label }}{{ ranking.scope ? ' de ' ~ ranking.scope.name }} · {% endif %}par <a href="{{ path('app_profile', {username: ranking.owner.username}) }}" class="underline">{{ ranking.owner.username }}</a> · {{ ranking.visibility.label }} · mis à jour le {{ ranking.updatedAt|date('d/m/Y') }}
                    </p>
                </div>
            </div>
        </header>

        {% if can_edit or ranking.public %}
            <div class="flex flex-col gap-3" {% if ranking.public %}data-controller="clipboard" data-clipboard-text-value="{{ share_url }}"{% endif %}>
                <div class="flex flex-wrap gap-2">
                    {% if can_edit %}
                        {% if active_duel %}
                            <a href="{{ path('app_duel_show', {id: ranking.id}) }}" class="btn btn-primary">Reprendre le duel</a>
                        {% elseif ranking.entries|length >= 2 %}
                            <form method="post" action="{{ path('app_duel_start_sort', {id: ranking.id}) }}">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <button type="submit" class="btn btn-primary">Classer par duel</button>
                            </form>
                        {% endif %}
                    {% endif %}
                    {% if ranking.public %}
                        <button type="button" class="btn" data-action="clipboard#copy" data-clipboard-target="button">Copier le lien</button>
                    {% endif %}
                    {% if can_edit %}
                        <form method="post" action="{{ path('app_ranking_visibility', {id: ranking.id}) }}">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <button type="submit" class="btn">{{ ranking.public ? 'Rendre privé' : 'Rendre public' }}</button>
                        </form>
                        <form method="post" action="{{ path('app_ranking_delete', {id: ranking.id}) }}" data-turbo-confirm="Supprimer ce classement ?">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <button type="submit" class="btn">Supprimer</button>
                        </form>
                    {% endif %}
                </div>
                {% if ranking.public %}
                    <input type="text" readonly value="{{ share_url }}" aria-label="Lien de partage" class="w-full font-mono text-[13px]">
                {% else %}
                    <p class="text-[13px] text-ink-muted">Ce classement est privé : rends-le public pour le partager.</p>
                {% endif %}
            </div>
        {% endif %}

        {% if comparable is not empty %}
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-semibold">Comparer avec :</span>
                {% for mine in comparable %}
                    <a href="{{ path('app_ranking_compare', {id: mine.id, otherId: ranking.id}) }}" class="btn">{{ mine.title }}</a>
                {% endfor %}
            </div>
        {% endif %}

        {% if missing_items is not empty %}
            <section class="card flex flex-col gap-3 p-4" aria-labelledby="missing-title">
                <h2 id="missing-title" class="font-bold">{{ missing_items|length }} élément{{ missing_items|length > 1 ? 's' }} pas encore classé{{ missing_items|length > 1 ? 's' }}</h2>
                <ul class="text-sm">
                    {% for item in missing_items %}<li>{{ item.name }}</li>{% endfor %}
                </ul>
                <div class="flex flex-wrap gap-2">
                    <form method="post" action="{{ path('app_duel_insert_missing', {id: ranking.id}) }}">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <button type="submit" class="btn btn-primary">Placer par duel</button>
                    </form>
                    <form method="post" action="{{ path('app_ranking_append_missing', {id: ranking.id}) }}">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <button type="submit" class="btn">Ajouter à la fin</button>
                    </form>
                </div>
            </section>
        {% endif %}

        <div class="{{ pool ? 'grid items-start gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]' }}">
            {% if pool %}
                {# Sur mobile, menu ouvert par le bas avec le bouton Ajouter (popover natif : Échap et
                   clic à côté le ferment). À partir de md, colonne fixe : on neutralise alors le style
                   du navigateur pour un popover (fixed, inset 0, marge auto, taille au contenu). #}
                <aside id="ranking-pool-sheet" popover aria-labelledby="pool-title"
                       class="card hidden flex-col gap-3 p-3 text-ink open:flex backdrop:bg-ink/40
                              max-md:inset-x-0 max-md:top-auto max-md:bottom-0 max-md:m-0 max-md:max-h-[85dvh] max-md:w-full max-md:max-w-none max-md:rounded-b-none max-md:border-b-0
                              md:sticky md:inset-auto md:top-4 md:m-0 md:flex md:h-auto md:w-auto md:overflow-visible">
                    <div class="flex items-center gap-3">
                        <div class="min-w-0 flex-1">
                            <h2 id="pool-title" class="font-bold">{{ ranking.itemKind.label }}{{ ranking.scope ? ' de ' ~ ranking.scope.name }}</h2>
                            {# La liste est cachée sous le menu : on rappelle où elle en est. #}
                            <p class="font-mono text-xs text-ink-muted md:hidden">{{ items|length }}{{ ranking.maxSize ? ' / ' ~ ranking.maxSize }} dans la liste{{ ranking.full ? ' · complet' }}</p>
                        </div>
                        <button type="button" popovertarget="ranking-pool-sheet" popovertargetaction="hide" class="btn-icon md:hidden" aria-label="Fermer">✕</button>
                    </div>
                    {# Permanent : le rafraîchissement après un ajout ne vide pas la recherche en cours. #}
                    <form id="ranking-pool-search" method="get" action="{{ path('app_ranking_pool', {id: ranking.id}) }}" role="search"
                          data-turbo-frame="ranking-pool" data-turbo-permanent data-controller="search" class="flex flex-col gap-2">
                        <input type="search" name="q" placeholder="Rechercher" aria-label="Rechercher dans le catalogue" autocomplete="off" class="w-full" data-action="search#submit">
                        {% if pool_filters is not empty %}
                            <select name="filter" aria-label="Filtrer par artiste ou album" class="w-full" data-action="search#submit">
                                <option value="">{{ ranking.scope ? 'Tout ' ~ ranking.scope.name : 'Tous les artistes' }}</option>
                                {% for group in pool_filters %}
                                    {% if group.label %}<optgroup label="{{ group.label }}">{% endif %}
                                    {% for item in group.items %}
                                        {# Dans un groupe, l'artiste lui-même vaut "tous ses albums". #}
                                        <option value="{{ item.id }}">{{ group.label and item.kind.value == 'artist' ? 'Tout ' ~ item.name : item.name }}</option>
                                    {% endfor %}
                                    {% if group.label %}</optgroup>{% endif %}
                                {% endfor %}
                            </select>
                        {% endif %}
                    </form>
                    <div class="min-h-0 flex-1 overflow-y-auto md:max-h-[calc(100vh-10rem)]">
                        {{ include('ranking/_pool.html.twig') }}
                    </div>
                </aside>
            {% endif %}

            {% if items is empty and not pool %}
                <p>Ce classement est vide.{% if can_edit and ranking.scope is null %} Ajoute des éléments depuis les pages <a href="{{ path('app_artist_index') }}" class="underline">artistes</a> et albums.{% endif %}</p>
            {% else %}
                <div class="flex flex-col gap-2">
                    {% if pool %}
                        <button type="button" popovertarget="ranking-pool-sheet" class="btn btn-primary w-full md:hidden">Ajouter</button>
                    {% endif %}
                    {% if ranking.maxSize %}
                        <p class="font-mono text-sm font-medium">{{ items|length }} / {{ ranking.maxSize }}{{ ranking.full and can_edit ? ' · complet : retire un élément pour en ajouter un autre' }}</p>
                    {% endif %}
                    {% if can_edit %}
                        <p class="text-[13px] text-ink-muted" data-sortable-status aria-live="polite">
                            {%- if pool and items is empty -%}
                                <span class="max-md:hidden">Glisse des éléments ici depuis le catalogue, ou ajoute-les avec +.</span>
                                <span class="md:hidden">Ajoute des éléments depuis le catalogue.</span>
                            {%- else -%}
                                Glisse les éléments par leur numéro<span class="max-sm:hidden">, ou utilise les flèches,</span> pour changer l'ordre.
                            {%- endif -%}
                        </p>
                    {% endif %}
                    <ol class="rank-list flex flex-col gap-2 {{ pool and items is empty ? 'min-h-[62px] rounded-control border-2 border-dashed border-rule' }}"
                        {% if can_edit %}
                            data-controller="sortable"
                            data-sortable-url-value="{{ path('app_ranking_order', {id: ranking.id}) }}"
                            data-sortable-token-value="{{ token }}"
                            {% if pool %}
                                data-sortable-group-value="ranking-{{ ranking.id }}"
                                data-sortable-full-value="{{ ranking.full ? 'true' : 'false' }}"
                            {% endif %}
                        {% endif %}>
                        {% for item in items %}
                            <li class="flex h-[62px] items-center gap-2.5 rounded-control border-2 border-ink bg-card pr-1.5" {% if can_edit %}data-item-id="{{ item.id }}"{% endif %}>
                                <span data-rank
                                      {% if can_edit %}data-sortable-handle title="Glisser pour déplacer"{% endif %}
                                      class="grid w-[46px] shrink-0 place-items-center self-stretch rounded-l-[10px] border-r-2 border-ink bg-sunken font-mono text-[17px] font-medium {{ can_edit ? 'cursor-grab touch-none select-none' }}">
                                    <span data-sortable-position>{{ '%02d'|format(loop.index) }}</span>
                                </span>
                                <div class="min-w-0 flex-1">{{ include('catalog/_item.html.twig', {item: item}) }}</div>
                                <div class="flex shrink-0 gap-1">
                                    {# De quoi se rafraîchir la mémoire avant de trancher. #}
                                    {% if item.kind.value == 'track' %}
                                        {{ include('catalog/_preview_button.html.twig', {track: item, class: ''}) }}
                                    {% elseif item.kind.value == 'album' %}
                                        {{ include('catalog/_tracklist_button.html.twig', {album: item, class: ''}) }}
                                    {% endif %}
                                    {% if can_edit %}
                                        <button type="button" class="btn-icon max-sm:hidden" data-action="sortable#moveUp" aria-label="Monter {{ item.name }}">↑</button>
                                        <button type="button" class="btn-icon max-sm:hidden" data-action="sortable#moveDown" aria-label="Descendre {{ item.name }}">↓</button>
                                        <details class="relative">
                                            <summary class="btn-icon list-none [&::-webkit-details-marker]:hidden" aria-label="Autres actions pour {{ item.name }}">⋯</summary>
                                            <div class="card absolute top-full right-0 z-10 mt-1 flex w-max flex-col p-1 text-sm font-semibold">
                                                <form method="post" action="{{ path('app_duel_place_item', {id: ranking.id}) }}">
                                                    <input type="hidden" name="itemId" value="{{ item.id }}">
                                                    <input type="hidden" name="_token" value="{{ token }}">
                                                    <button type="submit" class="w-full cursor-pointer rounded-tile px-3 py-2.5 text-left hover:bg-sunken">Replacer par duel</button>
                                                </form>
                                                <form method="post" action="{{ path('app_ranking_remove_item', {id: ranking.id}) }}">
                                                    <input type="hidden" name="itemId" value="{{ item.id }}">
                                                    <input type="hidden" name="_token" value="{{ token }}">
                                                    <button type="submit" class="w-full cursor-pointer rounded-tile px-3 py-2.5 text-left hover:bg-sunken">Retirer du classement</button>
                                                </form>
                                            </div>
                                        </details>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ol>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
