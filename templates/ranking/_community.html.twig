{# Classements publics portant sur un artiste ou un album. Variables : community_rankings #}
{% if community_rankings is not empty %}
    <section class="flex flex-col gap-3.5" aria-labelledby="community-title">
        <h2 id="community-title" class="text-lg font-bold">Classements de la communauté</h2>
        <ul class="flex flex-col">
            {% for ranking in community_rankings %}
                <li class="flex min-h-12 flex-wrap items-center gap-x-4 border-b border-rule py-1.5">
                    <a href="{{ path('app_ranking_show', {id: ranking.id}) }}" class="flex-1 font-mono text-sm font-medium uppercase">{{ ranking.title }}</a>
                    <a href="{{ path('app_profile', {username: ranking.owner.username}) }}" class="text-sm text-ink-muted underline">{{ ranking.owner.username }}</a>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
