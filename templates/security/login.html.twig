{% extends 'base.html.twig' %}

{% block title %}Connexion · Ranko{% endblock %}

{% block body %}
    <div class="mx-auto max-w-sm">
        <h1 class="mb-6 text-2xl">Connexion</h1>

        {% if error %}
            <p class="mb-4 border px-4 py-2" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}

        <form method="post" class="flex flex-col gap-4">
            <label class="flex flex-col gap-1">
                Email
                <input type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus class="border px-2 py-1">
            </label>
            <label class="flex flex-col gap-1">
                Mot de passe
                <input type="password" name="_password" autocomplete="current-password" required class="border px-2 py-1">
            </label>
            <label class="flex items-center gap-2">
                <input type="checkbox" name="_remember_me"> Rester connecté
            </label>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="border px-4 py-2">Se connecter</button>
        </form>
    </div>
{% endblock %}
