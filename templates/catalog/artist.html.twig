{% extends 'base.html.twig' %}

{% block title %}{{ artist.name }} · Ranko{% endblock %}

{% block body %}
    <div class="flex flex-col gap-6">
        <nav class="text-sm text-ink-muted"><a href="{{ path('app_artist_index') }}">Artistes</a> › {{ artist.name }}</nav>

        <header class="card overflow-hidden">
            <div class="stripes-stack h-[30px]" aria-hidden="true"></div>
            <div class="flex flex-col gap-4 p-4">
                <div class="flex flex-col gap-1">
                    <h1 class="text-3xl font-bold tracking-[-0.6px]">{{ artist.name }}</h1>
                    {% if artist.disambiguation %}<p class="font-mono text-sm text-ink-muted">{{ artist.disambiguation }}</p>{% endif %}
                </div>
                <div class="flex flex-wrap gap-2">
                    {{ include('ranking/_create_button.html.twig', {kind: 'album', scope: artist, label: 'Classer ses albums'}) }}
                    {{ include('ranking/_create_button.html.twig', {kind: 'track', scope: artist, label: 'Classer tous ses titres'}) }}
                    {{ include('ranking/_add_button.html.twig', {item: artist, label: 'Ajouter à mon top artistes'}) }}
                </div>
            </div>
        </header>

        <section class="flex flex-col gap-3.5" aria-labelledby="discography-title">
            <h2 id="discography-title" class="text-lg font-bold">Discographie</h2>
            {% if albums is empty %}
                <p>Aucun album pour l'instant.</p>
            {% else %}
                <ul class="grid grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-4">
                    {% for album in albums %}
                        <li class="card relative flex flex-col overflow-hidden">
                            {{ include('catalog/_cover.html.twig', {item: album, class: 'aspect-square w-full border-b-2 border-ink', sizes: '(min-width: 1024px) 240px, (min-width: 640px) 33vw, 50vw'}) }}
                            <div class="flex flex-col gap-0.5 p-3">
                                <a href="{{ path('app_album_show', {id: album.id}) }}" class="leading-tight font-bold after:absolute after:inset-0">{{ album.name }}</a>
                                <span class="font-mono text-xs text-ink-muted">{{ album.type.label }}{% if album.releaseYear %} · {{ album.releaseYear }}{% endif %}</span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {{ include('ranking/_community.html.twig') }}
    </div>
{% endblock %}
