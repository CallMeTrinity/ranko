{% extends 'base.html.twig' %}

{% block title %}Artistes · Ranko{% endblock %}

{% block body %}
    <div class="flex flex-col gap-5">
        <h1 class="text-[30px] font-bold tracking-[-0.6px]">Artistes</h1>

        <form method="get" class="flex gap-2">
            <input type="search" name="q" value="{{ query }}" placeholder="Chercher un artiste" aria-label="Chercher un artiste" class="min-w-0 flex-1">
            <button type="submit" class="btn btn-lg btn-primary">Chercher</button>
        </form>

        {% if artists is empty %}
            <p>Aucun artiste{% if query %} pour « {{ query }} »{% endif %}.</p>
        {% else %}
            <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                {% for artist in artists %}
                    <li class="flex min-h-[62px] items-center rounded-control border-2 border-ink bg-card px-2.5">{{ include('catalog/_item.html.twig', {item: artist}) }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
