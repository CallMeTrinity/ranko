{% extends 'base.html.twig' %}

{% block title %}Artistes · Ranko{% endblock %}

{% block body %}
    <h1 class="mb-6 text-2xl">Artistes</h1>

    <form method="get" class="mb-6 flex gap-2">
        <input type="search" name="q" value="{{ query }}" placeholder="Chercher un artiste" class="flex-1 border px-2 py-1">
        <button type="submit" class="border px-4 py-1">Chercher</button>
    </form>

    {% if artists is empty %}
        <p>Aucun artiste{% if query %} pour « {{ query }} »{% endif %}.</p>
    {% else %}
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {% for artist in artists %}
                <li class="border p-4">{{ include('catalog/_item.html.twig', {item: artist}) }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
