{# Un élément du catalogue sur une ligne : vignette, nom, contexte. Variables : item, cover_class (optionnel) #}
{% set kind = item.kind.value %}
<div class="flex items-center gap-2.5 min-w-0">
    {{ include('catalog/_cover.html.twig', {item: item, class: 'size-[42px] rounded-tile ' ~ (cover_class ?? '')}) }}
    <div class="min-w-0">
        {% if kind == 'artist' %}
            <a href="{{ path('app_artist_show', {id: item.id}) }}" class="block truncate text-[15px] font-semibold">{{ item.name }}</a>
            {% if item.disambiguation %}<span class="block truncate font-mono text-xs text-ink-muted">{{ item.disambiguation }}</span>{% endif %}
        {% elseif kind == 'album' %}
            <a href="{{ path('app_album_show', {id: item.id}) }}" class="block truncate text-[15px] font-semibold">{{ item.name }}</a>
            <span class="block truncate font-mono text-xs text-ink-muted">{{ item.artist.name }}{% if item.releaseYear %} · {{ item.releaseYear }}{% endif %}</span>
        {% else %}
            <span class="block truncate text-[15px] font-semibold">{{ item.name }}</span>
            <span class="block truncate font-mono text-xs text-ink-muted"><a href="{{ path('app_album_show', {id: item.album.id}) }}">{{ item.album.name }}</a> · {{ item.album.artist.name }}</span>
        {% endif %}
    </div>
</div>
