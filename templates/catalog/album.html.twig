{% extends 'base.html.twig' %}

{% block title %}{{ album.name }} · {{ album.artist.name }} · Ranko{% endblock %}

{% block body %}
    <div class="flex flex-col gap-6">
        <nav class="text-sm text-ink-muted">
            <a href="{{ path('app_artist_index') }}">Artistes</a> ›
            <a href="{{ path('app_artist_show', {id: album.artist.id}) }}">{{ album.artist.name }}</a> ›
            {{ album.name }}
        </nav>

        <header class="card overflow-hidden">
            <div class="stripes-stack h-[30px]" aria-hidden="true"></div>
            <div class="flex flex-col gap-5 p-4 sm:flex-row sm:items-center">
                {{ include('catalog/_cover.html.twig', {item: album, class: 'aspect-square w-full rounded-cover sm:w-56', alt: 'Pochette de ' ~ album.name}) }}
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-1">
                        <h1 class="text-3xl font-bold tracking-[-0.6px]">{{ album.name }}</h1>
                        <p class="font-mono text-sm text-ink-muted"><a href="{{ path('app_artist_show', {id: album.artist.id}) }}" class="underline">{{ album.artist.name }}</a>{% if album.releaseYear %} · {{ album.releaseYear }}{% endif %} · {{ album.type.label }}</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {{ include('ranking/_create_button.html.twig', {kind: 'track', scope: album, label: 'Classer les titres de l\'album'}) }}
                        {{ include('ranking/_add_button.html.twig', {item: album, label: 'Ajouter à mon top albums'}) }}
                    </div>
                </div>
            </div>
        </header>

        {% if tracks is empty %}
            <p>Titres pas encore importés.</p>
        {% else %}
            <ol class="flex flex-col">
                {% for track in tracks %}
                    <li class="flex min-h-14 items-center gap-3 border-b border-rule py-1.5">
                        <span class="w-7 shrink-0 text-right font-mono text-sm text-ink-muted">{{ '%02d'|format(track.position) }}</span>
                        <span class="flex-1 truncate font-semibold">{{ track.name }}</span>
                        <span class="shrink-0 font-mono text-sm text-ink-muted">{{ track.formattedDuration }}</span>
                        {{ include('ranking/_add_button.html.twig', {item: track, label: '+ Top titres'}) }}
                    </li>
                {% endfor %}
            </ol>
        {% endif %}

        {{ include('ranking/_community.html.twig') }}
    </div>
{% endblock %}
