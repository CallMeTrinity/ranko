{% extends 'base.html.twig' %}

{% set token = csrf_token('ranking' ~ ranking.id) %}

{% block title %}Duel · {{ ranking.title }} · Ranko{% endblock %}

{# Mode concentration : pas de barre d'onglets pendant le duel. #}
{% block navigation %}{% endblock %}

{% block body %}
    <div class="mx-auto flex max-w-xl flex-col gap-[18px]">
        <div class="flex items-center justify-between gap-4 text-sm text-ink-muted">
            <nav><a href="{{ path('app_ranking_show', {id: ranking.id}) }}">{{ ranking.title }}</a> › Duel</nav>
            <form method="post" action="{{ path('app_duel_abandon', {id: ranking.id}) }}" data-turbo-confirm="Abandonner ce duel ? Le classement ne sera pas modifié.">
                <input type="hidden" name="_token" value="{{ token }}">
                <button type="submit" class="cursor-pointer py-2.5 underline">Abandonner</button>
            </form>
        </div>

        <div class="flex items-center gap-3.5">
            <div class="flex gap-1 text-[30px]" aria-hidden="true">
                {% for digit in '%03d'|format(question)|split('') %}
                    <span class="counter-digit h-[46px] w-[34px]">{{ digit }}</span>
                {% endfor %}
            </div>
            <p class="text-sm leading-[1.35]">Question {{ question }}<br>au plus {{ max_remaining }} restante{{ max_remaining > 1 ? 's' }}</p>
        </div>

        <h1 class="text-[32px] font-bold tracking-[-0.6px]">{{ duel.type.value == 'sort' ? 'Lequel tu préfères ?' : 'Où le placer ?' }}</h1>

        <div class="grid grid-cols-2 gap-3" data-controller="duel" data-action="submit->duel#pick">
            {{ include('duel/_choice.html.twig', {choice: left, side: 'left'}) }}
            {{ include('duel/_choice.html.twig', {choice: right, side: 'right'}) }}
        </div>

        <div class="flex flex-col items-center gap-3">
            <p class="text-[13px] text-ink-muted">Touche la face que tu préfères<span class="max-md:hidden">, ou utilise ← et →</span></p>
            {% if duel.canUndo %}
                <form method="post" action="{{ path('app_duel_undo', {id: ranking.id}) }}">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <button type="submit" class="btn">Annuler la dernière réponse</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
